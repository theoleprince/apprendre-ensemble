# Copier en .env et remplacer les valeurs (ne jamais commiter .env)
HTTP_PORT=80
DB_PASSWORD=changer-ce-mot-de-passe
# >= 32 caracteres aleatoires, ex. : openssl rand -base64 48
APP_JWT_SECRET=changer-ce-secret-avec-au-moins-32-caracteres
APP_ADMIN_PASSWORD=changer-ce-mot-de-passe-admin
# true = cree les comptes et parcours de demonstration au premier demarrage
APP_SEED_DEMO=true
# URL publique (QR codes des certificats, liens LinkedIn) - HTTPS en production
APP_PUBLIC_URL=https://formation.exemple.org
# Assistant IA (Claude). Vide = mode local sans IA en ligne
ANTHROPIC_API_KEY=
APP_AI_MODEL=claude-opus-5-5
APP_BRAND_NAME=Plateforme de formation
