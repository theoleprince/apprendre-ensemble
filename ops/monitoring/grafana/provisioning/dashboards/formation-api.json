{
  "uid": "formation-api",
  "title": "API de formation - exploitation",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": 1, "type": "stat", "title": "API disponible", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [ { "expr": "up{job=\"formation-api\"}", "refId": "A" } ] },
    { "id": 2, "type": "timeseries", "title": "Requetes par seconde", "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "req/s", "refId": "A" } ] },
    { "id": 3, "type": "timeseries", "title": "Latence p50 / p95 / p99 (s)", "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" } ] },
    { "id": 4, "type": "timeseries", "title": "Erreurs 5xx / s", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "5xx", "refId": "A" } ] },
    { "id": 5, "type": "timeseries", "title": "Connexions base (actives / en attente)", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "actives", "refId": "A" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "en attente", "refId": "B" } ] },
    { "id": 6, "type": "timeseries", "title": "Memoire JVM (tas, octets)", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "utilise", "refId": "A" } ] },
    { "id": 7, "type": "timeseries", "title": "CPU processus", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [ { "expr": "process_cpu_usage", "legendFormat": "cpu", "refId": "A" } ] }
  ]
}
